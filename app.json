{
  "expo": {
    "name": "GunyDrive",
    "slug": "guny-drive-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gunydrive",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.gunydrive.mobile",
      "supportsTablet": true,
      "icon": "./assets/expo.icon",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "GunyDrive membutuhkan akses galeri untuk mencadangkan foto dan video Anda ke server pribadi.",
        "NSPhotoLibraryAddUsageDescription": "GunyDrive membutuhkan izin menyimpan berkas yang dipulihkan ke perangkat Anda."
      }
    },
    "android": {
      "package": "com.gunydrive.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "extra": {
      "githubReleaseRepos": [
        "hendra-it19/Guny-Drive-Mobile",
        "hendra-it19/Guny-Drive"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF1FB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#080B1A",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      "expo-background-task",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "GunyDrive menggunakan Face ID untuk masuk dengan cepat menggunakan Passkey biometrik."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "GunyDrive membutuhkan akses foto dan video untuk pencadangan otomatis ke server pribadi Anda.",
          "savePhotosPermission": "GunyDrive membutuhkan izin untuk memulihkan berkas ke galeri perangkat Anda.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": ["photo", "video", "audio"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
